{
  "expo": {
    "name": "iHambre",
    "slug": "menu-en-pareja",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "menuenpareja",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "es.nacho.menuenpareja"
    },
    "android": {
      "package": "es.nacho.menuenpareja",
      "adaptiveIcon": {
        "backgroundColor": "#fbf8f0",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "softwareKeyboardLayoutMode": "resize"
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "iHambre",
      "shortName": "iHambre",
      "themeColor": "#254c3b",
      "backgroundColor": "#fbf8f0",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-secure-store",
      "expo-font",
      ["expo-splash-screen", { "image": "./assets/splash-icon.png", "imageWidth": 200, "resizeMode": "contain", "backgroundColor": "#fbf8f0" }]
    ]
  }
}
